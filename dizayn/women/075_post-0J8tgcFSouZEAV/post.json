  "source_url": "https://www.facebook.com/BusinessHubTiraspol/posts/pfbid0J8tgcFSouZEAVNvE2iG33fnEC9g3pnyezGCj2FeYN3RYiwH3jpTT88szK9Q88tExl?__cft__[0]=AZg-hvc3cxXq9UL8Cry15PPrVRCysg-5UAgPdSOxAmmHJwW8eFXqv0rvp3bugTUazc-2sXnliGdyBimDaAcp2rRqQzn2x65eNe__uX7VsNUYqYJBZjRop97eRYQ48L71OBSYpR5ANQjUwmlHXTC2GXFG9we0s7gdWGGk42IMjDpM-5PUwkirkjnfhCI&__tn__=%2CO%2CP-R",
  "publication_date": "26 ноябрь 2025 г.",
