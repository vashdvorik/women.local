APP_NAME=Laravel
# Локальная разработка. На БОЕВОМ сервере обязательно: APP_ENV=production и APP_DEBUG=false.
# При APP_ENV=local включается тестовый вход в кабинет (/dev/account-login) и создаются тестовые участницы.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inspair
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Telegram Bot
TELEGRAM_TOKEN=your-bot-token-here
TELEGRAM_COMMUNITY_URL=https://inspair.community

# Подписки кабинета участницы (docs/SUBSCRIPTIONS.md). Цены в целых рублях за 12 месяцев — стартовые:
# администратор меняет их в админке («Подписки → Цена подписки на год»), и тогда действуют цены оттуда.
SUBSCRIPTION_COMMUNITY_PRICE=600
SUBSCRIPTION_PRIVATE_PRICE=20000

# Web-платёж Агропромбанка. На своём компьютере по умолчанию работает «имитатор банка» (деньги не нужны).
# На боевом сервере: WEBPAYMENT_DRIVER=bank, логин и пароль торговца выдаёт банк. Пока WEBPAYMENT_TEST=true,
# платежи тестовые и деньги не списываются; боевыми они становятся только при WEBPAYMENT_TEST=false.
WEBPAYMENT_DRIVER=fake
WEBPAYMENT_TEST=true
WEBPAYMENT_MERCHANT_LOGIN=
WEBPAYMENT_MERCHANT_PASS=
# Необязательно: сертификат банка (PEM) и алгоритм для проверки подписи ответов GetState, если банк их назовёт.
WEBPAYMENT_BANK_CERT=
WEBPAYMENT_BANK_SIGNATURE_ALGO=sha256

# Админка (/admin): пускается ровно одна почта. ADMIN_PASSWORD нужен только для
# php artisan db:seed --class=AdminUserSeeder (не короче 12 символов).
ADMIN_NAME="Редактор"
ADMIN_EMAIL=
ADMIN_PASSWORD=
