# Кеш файлов в браузере (и на CDN): повторный заход не скачивает лишнего, а после обновления сайта человек видит
# новую версию.
#  - /uploads (фото из админки) и /build (скрипты и стили админки с хешем в имени): имя файла уникально и при замене
#    меняется (перекадрированное фото сохраняется под новым именем), поэтому файл не изменится никогда: год, без проверки;
#  - /themes и /images (стили, скрипты и картинки сайта лежат под постоянными именами): кеш с проверкой при каждом
#    заходе. Файл не менялся — сервер отвечает 304 без тела, изменился — отдаёт новый. Так обновляется и то, что стили
#    подтягивают сами (картинки и шрифты в url(...)). Страницы подключают css и js с меткой ?v=время изменения
#    (asset_v(), app/Support/Assets.php), так что и промежуточный кеш не удержит старую версию;
#  - остальные картинки и шрифты: неделя.
# Сами HTML-страницы такой заголовок не получают: Laravel отдаёт их с no-cache. Без модулей Apache блок молча пропускается.
<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "/(uploads|build)/" LONG_LIVED_FILE
    SetEnvIf Request_URI "/(themes|images)/" REVALIDATE_FILE
</IfModule>
<IfModule mod_headers.c>
    Header set Cache-Control "no-cache" env=REVALIDATE_FILE
    Header set Cache-Control "public, max-age=31536000, immutable" env=LONG_LIVED_FILE
    <FilesMatch "\.(avif|gif|ico|jpe?g|png|svg|webp|woff2?)$">
        Header setifempty Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
